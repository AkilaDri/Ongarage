{
  "name": "ongarage",
  "private": true,
  "description": "OnGarage monorepo: vehicle-owner, garage, parts shop and technician apps, and shared code.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "user": "npm run start --workspace @ongarage/user",
    "user:web": "npm run web --workspace @ongarage/user",
    "garage": "npm run start --workspace @ongarage/garage",
    "garage:web": "npm run web --workspace @ongarage/garage",
    "parts": "npm run start --workspace @ongarage/parts",
    "parts:web": "npm run web --workspace @ongarage/parts",
    "tech": "npm run start --workspace @ongarage/tech",
    "tech:web": "npm run web --workspace @ongarage/tech",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @ongarage/shared --",
    "e2e": "node e2e/run.cjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
