# API Configuration
API_BASE_URL=https://api.example.com
API_KEY=your-api-key-here

# Maps: with no Google key the app uses OpenStreetMap. Set EXPO_PUBLIC_MAP_PROVIDER=osm or =google to force one.
# EXPO_PUBLIC_MAP_PROVIDER=osm

# Google Maps (needs Maps Static API, Geocoding API, Places API (New) enabled + billing)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Environment
ENV=development

# Feature Flags
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
