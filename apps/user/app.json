{
  "expo": {
    "name": "OnGarage",
    "slug": "ongarage-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ongarageapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ongarage.app",
      "supportsTabletMode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ongarage.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OnGarage uses your location to find nearby garages and send SOS help to where your vehicle stopped."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OnGarage needs access to your photos so you can attach pictures of your vehicle, parts and jobs.",
          "cameraPermission": "OnGarage needs your camera so you can take pictures of your vehicle, parts and jobs.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
